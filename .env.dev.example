# 開発中の動作確認用（APP_ENV=dev php artisan serve --port=8001）。
# cp .env.dev.example .env.dev してから php artisan key:generate --env=dev を実行する。
APP_NAME="Laravel Learning (dev)"
APP_ENV=dev
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=learning_dev
DB_USERNAME=app
DB_PASSWORD=secret

LEARNING_DB_PROTECTED=false

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
