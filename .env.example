APP_NAME="Laravel Learning"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# 学習用DB。DB_DATABASE は書かない（config/database.php の既定値 database/learning.sqlite を絶対パスで使う）。
# 書く場合は絶対パスにする（php artisan serve の子プロセスは public/ で動くため、相対パスは別の場所を指す）。
DB_CONNECTION=sqlite

# 学習用DBで migrate:fresh などの記録を消すコマンドを禁止する（docs/02_architecture.md 4章）
LEARNING_DB_PROTECTED=true

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
