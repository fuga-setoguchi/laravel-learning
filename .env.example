APP_NAME="Laravel Learning"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# DBは Docker の PostgreSQL（compose.yaml）。learning が学習用（docs/02_architecture.md 4章）
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=learning
DB_USERNAME=app
DB_PASSWORD=secret

# 学習用DBで migrate:fresh などの記録を消すコマンドを禁止する（docs/02_architecture.md 4章）
LEARNING_DB_PROTECTED=true

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
